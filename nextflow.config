manifest {
    name = 'tylergross97/nextflow_xengsort'
    author = 'Tyler Gross'
    description = 'Nextflow pipeline for xengsort classification'
    version = '1.0.0'
    mainScript = 'main.nf'
    homePage = 'https://github.com/tylergross97/nextflow_xengsort'
    defaultBranch = 'main'
}

params {
    input = null
    outdir_base = null
    outdir_references = "${params.outdir_base}/references"
    outdir_fastp = "${params.outdir_base}/fastp"
    outdir_xengsort = "${params.outdir_base}/xengsort"
    hg38_fasta = null
    nsg_fasta = null
    outdir_multiqc = "${params.outdir_base}/multiqc"
}

profiles {
    docker {
        docker {
            enabled = true
        }
    }
    singularity {
        singularity {
            enabled = true
            autoMounts = true
        }
    }
    
    test_minimal {
        process {
            // Reduce memory requirements for all processes in minimal test mode
            memory = '2.GB'
            cpus = 2
            
            // Specific configuration for memory-intensive processes
            withName: 'XENGSORT_CLASSIFY' {
                memory = '4.GB'
                cpus = 2
            }
            
            withName: 'XENGSORT_INDEX' {
                memory = '2.GB'
                cpus = 2
            }
        }
        params {
            input = "${projectDir}/test_minimal/data/xengsort/samplesheet.csv"
            hg38_fasta = "${projectDir}/test_minimal/data/xengsort/human.fa"
            nsg_fasta = "${projectDir}/test_minimal/data/xengsort/mouse.fa"
            outdir_base = 'results_test_minimal'
            outdir_references = "results_test_minimal/references"
            outdir_fastp = "results_test_minimal/fastp"
            outdir_xengsort = "results_test_minimal/xengsort"
            outdir_multiqc = "results_test_minimal/multiqc"
        }
    }
    
    test_full {
        process {
            // Full-scale resource settings for WES data
            withName: 'FASTP' {
                cpus = 8
                memory = '16.GB'
                time = '4.h'
            }
            
            withName: 'XENGSORT_INDEX' {
                cpus = 8
                memory = '32.GB'
                time = '2.h'
            }
            
            withName: 'XENGSORT_CLASSIFY' {
                cpus = 8
                memory = '32.GB'
                time = '6.h'
            }
            
            withName: 'MULTIQC' {
                cpus = 2
                memory = '4.GB'
                time = '30.min'
            }
        }
        
        params {
            // Input data
            input = "${projectDir}/test_full/data/full/samplesheet.csv"
            
            // Output directory
            outdir_base = "results_test_full"
            outdir_references = "results_test_full/references"
            outdir_fastp = "results_test_full/fastp"
            outdir_xengsort = "results_test_full/xengsort"
            outdir_multiqc = "results_test_full/multiqc"
            
            // Reference genomes - MUST be provided via command line or launch parameters
            // These are not bundled due to large file sizes
            // 
            // Example command:
            //   nextflow run tylergross97/nextflow_xengsort \
            //     -profile test_full,docker \
            //     --hg38_fasta s3://your-bucket/GRCh38.fa \
            //     --nsg_fasta s3://your-bucket/mm10_nsg.fa
            //
            // Leave as null to force users to specify
            // hg38_fasta and nsg_fasta inherit from main params block (null by default)
            
            // Process settings for WES data
            fastp_args = "--detect_adapter_for_pe --cut_front --cut_tail --cut_mean_quality 20"
        }
        
        // Execution settings
        executor {
            queueSize = 4
            pollInterval = '30 sec'
        }
    }
}
